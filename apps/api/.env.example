# FastAPI service configuration. Compose overrides the database host with its
# internal PostgreSQL service; direct local execution requires a reachable URL.
# The orchestration enablement and activation-date flags belong in the root
# .env because Compose injects role-specific values into worker/dispatcher.
DAILY_INSIGHTS_ENVIRONMENT=development
DAILY_INSIGHTS_DATABASE_URL=postgresql+psycopg://daily_insights:CHANGE_ME_LOCAL_DATABASE_PASSWORD@localhost:5432/daily_insights
DAILY_INSIGHTS_SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
DAILY_INSIGHTS_PASSWORD_PEPPER=CHANGE_ME_INDEPENDENT_RANDOM_SECRET

DAILY_INSIGHTS_FINDB_BASE_URL=https://findb.tingfong.com
DAILY_INSIGHTS_FINDB_API_KEY=CHANGE_ME_FINDB_API_KEY
DAILY_INSIGHTS_MORNING_REPORTS_ENABLED=false
DAILY_INSIGHTS_ANALYST_VIEWPOINTS_ENABLED=false
DAILY_INSIGHTS_ANALYST_VIEWPOINTS_BASE_URL=https://CHANGE_ME_ANALYST_VIEWPOINTS_HOST
DAILY_INSIGHTS_ANALYST_VIEWPOINTS_API_KEY=CHANGE_ME_ANALYST_VIEWPOINTS_API_KEY
DAILY_INSIGHTS_ANALYST_VIEWPOINTS_TIMEOUT_SECONDS=10
DAILY_INSIGHTS_TWELVE_DATA_BASE_URL=https://api.twelvedata.com
DAILY_INSIGHTS_TWELVE_DATA_API_KEY=CHANGE_ME_TWELVE_DATA_API_KEY

DAILY_INSIGHTS_CHAT_ENABLED=false
DAILY_INSIGHTS_CHAT_MODEL_PROVIDER=openai
DAILY_INSIGHTS_CHAT_MODEL_NAME=gpt-6-luna
DAILY_INSIGHTS_CHAT_MODEL_API_BASE_URL=https://api.openai.com/v1
DAILY_INSIGHTS_CHAT_MODEL_API_KEY=CHANGE_ME_CHAT_MODEL_API_KEY
DAILY_INSIGHTS_CHAT_MODEL_REASONING_EFFORT=medium
DAILY_INSIGHTS_CHAT_MAX_OUTPUT_TOKENS=16384
DAILY_INSIGHTS_CHAT_TIMEOUT_SECONDS=180

# Newsroom key-news pipeline (docs/architecture/daily-news.md). Compose always
# starts newsroom-worker; while ENABLED is false it only idles, and the 08:00
# newsroom_assemble function is skipped. Once true, the worker refuses to start
# without real HTTPS LLM and embedding keys. Every LLM stage has its own model.
DAILY_INSIGHTS_NEWSROOM_ENABLED=false
# The LLM defaults use OpenAI GPT-6 Luna (high reasoning). Legacy provider setups
# (DeepSeek and OpenCode Go) remain listed in docs/runbooks/news-recovery.md,
# section "切換 LLM 供應商"; containers must be recreated to pick up a change.
DAILY_INSIGHTS_NEWSROOM_LLM_BASE_URL=https://api.openai.com/v1
DAILY_INSIGHTS_NEWSROOM_LLM_API_KEY=CHANGE_ME_NEWSROOM_LLM_API_KEY
# User-Agent of every LLM call, and an optional header carrying a stable
# per-stage session id. For OpenCode Go set BASE_URL to
# https://opencode.ai/inference/go/openai/v1, the models to deepseek-v4.1-flash
# and SESSION_HEADER to x-opencode-session: Go rejects calls without it, so the
# services refuse to start on an opencode.ai BASE_URL while it is empty.
DAILY_INSIGHTS_NEWSROOM_LLM_TIMEOUT_SECONDS=240
DAILY_INSIGHTS_NEWSROOM_LLM_MAX_COMPLETION_TOKENS=32768
DAILY_INSIGHTS_NEWSROOM_LLM_USER_AGENT=daily-insights-newsroom/1.0
DAILY_INSIGHTS_NEWSROOM_LLM_SESSION_HEADER=
# JSON object merged into every chat completion body (empty sends nothing extra;
# model, messages, response_format, temperature and stream are refused). The
# prompts are tuned without reasoning, so OpenCode Go needs
# '{"thinking":{"type":"disabled"}}'.
DAILY_INSIGHTS_NEWSROOM_LLM_EXTRA_BODY=
DAILY_INSIGHTS_NEWSROOM_TRIAGE_MODEL=gpt-6-luna
DAILY_INSIGHTS_NEWSROOM_EDITOR_MODEL=gpt-6-luna
DAILY_INSIGHTS_NEWSROOM_ANALYSIS_MODEL=gpt-6-luna
DAILY_INSIGHTS_NEWSROOM_TRANSLATE_MODEL=gpt-6-luna
# Editor calls only (selection, dedupe, repeat screen): JSON fields merged over
# LLM_EXTRA_BODY (top-level keys replace), e.g.
# '{"thinking":{"type":"enabled"},"reasoning_effort":"high"}', and their own
# timeout in seconds (at most 300). Empty inherits the shared values.
DAILY_INSIGHTS_NEWSROOM_EDITOR_EXTRA_BODY=
DAILY_INSIGHTS_NEWSROOM_EDITOR_TIMEOUT_SECONDS=
DAILY_INSIGHTS_NEWSROOM_EMBEDDING_BASE_URL=https://api.openai.com/v1
DAILY_INSIGHTS_NEWSROOM_EMBEDDING_API_KEY=CHANGE_ME_NEWSROOM_EMBEDDING_API_KEY
DAILY_INSIGHTS_NEWSROOM_EMBEDDING_MODEL=text-embedding-3-large
# Optional: without a https://hooks.slack.com/ webhook, notices only reach the log.
DAILY_INSIGHTS_NEWSROOM_SLACK_WEBHOOK_URL=
# Origin used for the review-console links inside Slack notices.
DAILY_INSIGHTS_NEWSROOM_ADMIN_BASE_URL=http://localhost:8080
# Newsroom ingestion. The article allowlist is every enabled source hostname in
# newsroom_sources; these add or block exact hostnames (a blocked host is not
# polled and cannot be submitted as a manual URL).
DAILY_INSIGHTS_NEWS_EXTRA_HOSTNAMES=
DAILY_INSIGHTS_NEWS_BLOCKED_HOSTNAMES=
# Skip robots.txt on feed polls and article fetches. SSRF allowlisting and
# blocked-host kill switches still apply. Set false to restore robots checks.
DAILY_INSIGHTS_NEWS_IGNORE_ROBOTS=true
DAILY_INSIGHTS_NEWS_FETCH_TIMEOUT_SECONDS=25
DAILY_INSIGHTS_NEWS_DISCOVERY_TIMEOUT_SECONDS=30
# Optional credentialed sources; a source is skipped (and shows the missing
# credential in source health) while its value is empty.
DAILY_INSIGHTS_GUARDIAN_API_KEY=
DAILY_INSIGHTS_SEC_CONTACT_EMAIL=

DAILY_INSIGHTS_R2_ENDPOINT_URL=https://CHANGE_ME_R2_ACCOUNT_ID.r2.cloudflarestorage.com
DAILY_INSIGHTS_R2_BUCKET_NAME=CHANGE_ME_R2_BUCKET_NAME
DAILY_INSIGHTS_R2_ACCESS_KEY_ID=CHANGE_ME_R2_ACCESS_KEY_ID
DAILY_INSIGHTS_R2_SECRET_ACCESS_KEY=CHANGE_ME_R2_SECRET_ACCESS_KEY
DAILY_INSIGHTS_R2_SIGNED_URL_TTL_SECONDS=900
DAILY_INSIGHTS_PODCAST_UPLOAD_PRESIGN_TTL_SECONDS=900
DAILY_INSIGHTS_PODCAST_UPLOAD_CLEANUP_GRACE_SECONDS=86400
DAILY_INSIGHTS_PODCAST_MEDIA_POLL_SECONDS=2

# Yahoo has no published API contract, so the back-office fetch endpoint is
# opt-in.
DAILY_INSIGHTS_YFINANCE_ENABLED=true

# TWSE rwd (三大法人) has no API contract and unverified datacenter reachability,
# so the fetch is opt-in. Requests are spaced by the interval below, and a
# transient failure is retried up to RETRY_ATTEMPTS times at a growing interval.
DAILY_INSIGHTS_TWSE_ENABLED=true
DAILY_INSIGHTS_TWSE_REQUEST_INTERVAL_SECONDS=6
DAILY_INSIGHTS_TWSE_RETRY_ATTEMPTS=3

# TradingView HSI sector heatmap: screenshots via headless Chromium, PNGs stored in
# R2 (same credentials as the podcast assets). Opt-in; needs the worker image built
# with Chromium.
DAILY_INSIGHTS_TRADINGVIEW_ENABLED=true
DAILY_INSIGHTS_TRADINGVIEW_TIMEOUT_SECONDS=30
DAILY_INSIGHTS_TRADINGVIEW_HEATMAP_RETENTION_DAYS=90
