# Reference contract for GitHub production Secrets and Variables.
# The SSH deployment process passes these values directly to Docker Compose;
# this file is never copied to EC2 or mounted into a container.
# Keep this list aligned with the deploy job env in .github/workflows/release.yml.
DAILY_INSIGHTS_ENVIRONMENT=production
DAILY_INSIGHTS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@RDS_PRIVATE_HOST:5432/daily_insights?sslmode=require
DAILY_INSIGHTS_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DAILY_INSIGHTS_PASSWORD_PEPPER=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_SECRET
DAILY_INSIGHTS_TRUSTED_PROXY_CIDRS=172.30.0.0/24
PUBLIC_HOSTNAME=REPLACE_WITH_PRODUCTION_HOSTNAME

# Morning reports (Variables: ENABLED, BASE_URL; Secret: API_KEY). The API key
# is required only while the flag is true.
DAILY_INSIGHTS_MORNING_REPORTS_ENABLED=false
DAILY_INSIGHTS_TWELVE_DATA_BASE_URL=https://api.twelvedata.com
DAILY_INSIGHTS_TWELVE_DATA_API_KEY=REPLACE_FROM_SECRET_STORE

# Index daily bars, institutional flows and the HSI sector heatmap
# (always-required boolean Variables).
DAILY_INSIGHTS_YFINANCE_ENABLED=false
DAILY_INSIGHTS_TWSE_ENABLED=false
DAILY_INSIGHTS_TRADINGVIEW_ENABLED=false

# Newsroom switch: existing GitHub Variable DAILY_INSIGHTS_DAILY_NEWS_ENABLED.
# Native endpoint: Secret DAILY_INSIGHTS_NEWSROOM_OPENAI_API_KEY. Other endpoints:
# legacy DAILY_INSIGHTS_NEWS_MODEL_API_KEY. Both deploy as NEWSROOM_LLM_API_KEY.
# The native key must exist when enabled; it never falls back to the legacy key.
# Embeddings use their own Secret NEWSROOM_EMBEDDING_API_KEY. Slack is optional.
# See docs/runbooks/openai-luna-migration.md for tuning and rollback.
# From the GitHub Variable DAILY_INSIGHTS_DAILY_NEWS_ENABLED.
DAILY_INSIGHTS_NEWSROOM_ENABLED=false
DAILY_INSIGHTS_NEWSROOM_LLM_BASE_URL=https://api.openai.com/v1
# OpenAI: GitHub Secret DAILY_INSIGHTS_NEWSROOM_OPENAI_API_KEY.
# Legacy endpoints: GitHub Secret DAILY_INSIGHTS_NEWS_MODEL_API_KEY.
DAILY_INSIGHTS_NEWSROOM_LLM_API_KEY=REPLACE_FROM_SECRET_STORE
DAILY_INSIGHTS_NEWSROOM_TRIAGE_MODEL=gpt-6-luna
DAILY_INSIGHTS_NEWSROOM_EDITOR_MODEL=gpt-6-luna
DAILY_INSIGHTS_NEWSROOM_ANALYSIS_MODEL=gpt-6-luna
DAILY_INSIGHTS_NEWSROOM_TRANSLATE_MODEL=gpt-6-luna
# Provider switches (docs/runbooks/news-recovery.md, "切換 LLM 供應商"). OpenCode
# Go needs SESSION_HEADER=x-opencode-session (the services refuse to start
# without it) and LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}. The two
# JSON values must stay on one line; empty EDITOR_* values inherit the shared ones.
DAILY_INSIGHTS_NEWSROOM_LLM_TIMEOUT_SECONDS=240
DAILY_INSIGHTS_NEWSROOM_LLM_MAX_COMPLETION_TOKENS=32768
DAILY_INSIGHTS_NEWSROOM_LLM_USER_AGENT=daily-insights-newsroom/1.0
DAILY_INSIGHTS_NEWSROOM_LLM_SESSION_HEADER=
DAILY_INSIGHTS_NEWSROOM_LLM_EXTRA_BODY=
DAILY_INSIGHTS_NEWSROOM_EDITOR_EXTRA_BODY=
DAILY_INSIGHTS_NEWSROOM_EDITOR_TIMEOUT_SECONDS=
DAILY_INSIGHTS_NEWSROOM_EMBEDDING_BASE_URL=https://api.openai.com/v1
DAILY_INSIGHTS_NEWSROOM_EMBEDDING_API_KEY=REPLACE_FROM_SECRET_STORE
DAILY_INSIGHTS_NEWSROOM_EMBEDDING_MODEL=text-embedding-3-small
DAILY_INSIGHTS_NEWSROOM_SLACK_WEBHOOK_URL=
# Newsroom ingestion (Variables, all optional). The article allowlist is every
# enabled source's hostname in newsroom_sources; these only add hosts or block
# them (blocking also stops polling the host and rejects admin manual URLs).
DAILY_INSIGHTS_NEWS_EXTRA_HOSTNAMES=
DAILY_INSIGHTS_NEWS_BLOCKED_HOSTNAMES=
# Skip robots.txt on feed polls and article fetches (default true). SSRF
# allowlisting and blocked-host kill switches still apply.
DAILY_INSIGHTS_NEWS_IGNORE_ROBOTS=true
# Optional credentialed sources (Secret: GUARDIAN_API_KEY; Variable:
# SEC_CONTACT_EMAIL). A source whose value is empty is skipped and shows the
# missing-credential code in the admin source health view.
DAILY_INSIGHTS_GUARDIAN_API_KEY=
DAILY_INSIGHTS_SEC_CONTACT_EMAIL=

# Analyst viewpoints (Variables: ENABLED, BASE_URL, TIMEOUT_SECONDS; Secret:
# API_KEY). BASE_URL, TIMEOUT_SECONDS, and API_KEY are required only while
# ENABLED is true; ENABLED itself is always required.
DAILY_INSIGHTS_ANALYST_VIEWPOINTS_ENABLED=false
DAILY_INSIGHTS_ANALYST_VIEWPOINTS_BASE_URL=https://ANALYST_VIEWPOINTS_HOST
DAILY_INSIGHTS_ANALYST_VIEWPOINTS_API_KEY=REPLACE_FROM_SECRET_STORE
DAILY_INSIGHTS_ANALYST_VIEWPOINTS_TIMEOUT_SECONDS=10

# Chat (Variables: ENABLED, MODEL_PROVIDER, MODEL_NAME, MODEL_API_BASE_URL,
# TIMEOUT_SECONDS; Secret: MODEL_API_KEY). ENABLED is always required; all five
# model settings are required only while it is true.
DAILY_INSIGHTS_CHAT_ENABLED=false
DAILY_INSIGHTS_CHAT_MODEL_PROVIDER=openai
DAILY_INSIGHTS_CHAT_MODEL_NAME=gpt-6-luna
DAILY_INSIGHTS_CHAT_MODEL_API_BASE_URL=https://api.openai.com/v1
DAILY_INSIGHTS_CHAT_MODEL_API_KEY=REPLACE_FROM_SECRET_STORE
DAILY_INSIGHTS_CHAT_MODEL_REASONING_EFFORT=medium
DAILY_INSIGHTS_CHAT_MAX_OUTPUT_TOKENS=16384
DAILY_INSIGHTS_CHAT_TIMEOUT_SECONDS=180

# R2 (Variables: ENDPOINT_URL, BUCKET_NAME, SIGNED_URL_TTL_SECONDS; Secrets: keys).
DAILY_INSIGHTS_R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
DAILY_INSIGHTS_R2_BUCKET_NAME=production-podcast-assets
DAILY_INSIGHTS_R2_ACCESS_KEY_ID=REPLACE_FROM_SECRET_STORE
DAILY_INSIGHTS_R2_SECRET_ACCESS_KEY=REPLACE_FROM_SECRET_STORE
DAILY_INSIGHTS_R2_SIGNED_URL_TTL_SECONDS=900
