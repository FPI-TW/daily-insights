# Compose infrastructure configuration. Application settings live in each
# service directory. Never commit the resulting .env file.

APP_PORT=8080

POSTGRES_DB=daily_insights
POSTGRES_USER=daily_insights
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DATABASE_PASSWORD

# Local Compose enables the unified worker and dispatcher by default. These are
# Compose interpolation settings; keep them in the root .env, not apps/api/.env.
DAILY_INSIGHTS_ORCHESTRATION_ENABLED=true
DAILY_INSIGHTS_ORCHESTRATION_ACTIVATION_DATE=1970-01-01
