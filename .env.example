# Development-only placeholders. Copy this file to .env and replace every
# CHANGE_ME value. Never commit the resulting .env file.

APP_PORT=8080
APP_ENV=development
APP_BASE_URL=http://localhost:8080

POSTGRES_DB=daily_insights
POSTGRES_USER=daily_insights
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://daily_insights:CHANGE_ME_LOCAL_DATABASE_PASSWORD@postgres:5432/daily_insights

DAILY_INSIGHTS_SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
DAILY_INSIGHTS_PASSWORD_PEPPER=CHANGE_ME_INDEPENDENT_RANDOM_SECRET

FINDB_BASE_URL=https://findb.tingfong.com
FINDB_API_KEY=CHANGE_ME_FINDB_API_KEY

MODEL_PROVIDER=deepseek
MODEL_NAME=CHANGE_ME_MODEL_NAME
MODEL_API_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=CHANGE_ME_MODEL_API_KEY

R2_ACCOUNT_ID=CHANGE_ME_R2_ACCOUNT_ID
R2_BUCKET_NAME=CHANGE_ME_R2_BUCKET_NAME
R2_ACCESS_KEY_ID=CHANGE_ME_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=CHANGE_ME_R2_SECRET_ACCESS_KEY
R2_SIGNED_URL_TTL_SECONDS=900

DEFAULT_LOCALE=zh-TW
SUPPORTED_LOCALES=zh-TW,zh-CN,en
