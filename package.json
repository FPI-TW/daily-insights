{
  "name": "daily-insights",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "pnpm --filter @daily-insights/web dev",
    "generate-routes": "pnpm --filter @daily-insights/web generate-routes",
    "build": "pnpm --filter @daily-insights/web build",
    "preview": "pnpm --filter @daily-insights/web preview",
    "format": "pnpm --filter @daily-insights/web format",
    "format:check": "pnpm --filter @daily-insights/web format:check",
    "lint": "pnpm --filter @daily-insights/web lint",
    "lint:check": "pnpm --filter @daily-insights/web lint:check",
    "type:check": "pnpm --filter @daily-insights/web type:check",
    "test": "pnpm --filter @daily-insights/web test",
    "test:watch": "pnpm --filter @daily-insights/web test:watch",
    "test:coverage": "pnpm --filter @daily-insights/web test:coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
